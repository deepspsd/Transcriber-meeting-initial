MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=voicesum

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Groq API (required for AI summaries/Q&A)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# HuggingFace (optional — enables pyannote speaker diarization)
# If not set, fallback energy-based diarization is used
# HF_TOKEN=your_huggingface_token_here

# Audio storage (local folder relative to backend/)
UPLOAD_DIR=uploads

# Speaker identification
SPEAKER_SIMILARITY_THRESHOLD=0.75
MIN_SEGMENT_DURATION=1.5

# Transcription
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Word confidence thresholds
WORD_CONF_LOW=0.7
WORD_CONF_MID=0.85
